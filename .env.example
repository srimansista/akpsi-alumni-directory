# Database (Neon, Supabase, or local PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/akpsi_portal?schema=public"

# NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional - get from console.cloud.google.com)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email - Resend (https://resend.com)
RESEND_API_KEY="re_..."
EMAIL_FROM="AKPsi Omega Theta <noreply@yourdomain.com>"

# Access Control: "public" (no login required) or "protected" (login required)
DIRECTORY_ACCESS="public"

# Initial admin email (set before first run)
ADMIN_EMAIL="vpalumni@omegatheta.org"
ADMIN_PASSWORD="change-me"

# Toggle Google sign-in button in UI
NEXT_PUBLIC_GOOGLE_ENABLED="false"
