# Managed PostgreSQL (Neon or Supabase). Use TLS for hosted connections.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/akpsi_portal?sslmode=require"
# Optional direct connection for migrations; Neon provisions this automatically.
DATABASE_URL_UNPOOLED=""

# Auth.js: generate a random secret and set the public site URL.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Transactional email: verify sender/domain with Resend before enabling signup.
RESEND_API_KEY=""
EMAIL_FROM="AKPsi Omega Theta <noreply@yourdomain.com>"
SUBMISSION_APPROVAL_EMAIL=""

# First administrator. Run npm run db:admin with a unique 12+ character password.
# ADMIN_PASSWORD is only used by bootstrap-admin; normal login reads the database hash.
ADMIN_EMAIL=""
ADMIN_NAME="Chapter Administrator"
ADMIN_PASSWORD=""
